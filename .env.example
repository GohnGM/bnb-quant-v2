# =============================================================================
# bnb-quant-v2 环境变量（复制为 .env 后填写）
# 接手指南：docs/GATE_API_SETUP.md
# =============================================================================

# --- Gate 实时 K 线（config/live_sync.yaml enabled=true 时使用）---
# Spot K 线是公开接口，通常不需要 Key；网络受限或限流时可配置。
# 在 Gate.io → API 管理 创建 v4 Key（只读权限即可，勿开交易/提现）
GATE_API_KEY=
GATE_API_SECRET=

# --- Telegram（config/telegram.yaml enabled=true, dry_run=false）---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Email（config/email.yaml enabled=true, dry_run=false）---
# 推荐在 config/email.yaml 中配置用户名和 SMTP 参数，此处仅填密码
# QQ邮箱：使用授权码作为密码（非登录密码）
# Gmail：使用应用密码
# EMAIL_USERNAME=
# EMAIL_PASSWORD=
# EMAIL_SMTP_HOST=smtp.qq.com
# EMAIL_SMTP_PORT=465

# --- Binance（备选，阶段 F，当前未实现）---
# BINANCE_API_KEY=
# BINANCE_API_SECRET=
# BINANCE_TESTNET=true
